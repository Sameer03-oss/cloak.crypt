# Copy this file to .env for local development. Never commit .env.
PORT=5173
API_PORT=8080
BASE_PATH=/
DB_NAME=AARYAN

# Use the same Clerk publishable key in both variables.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=

# Server-only credentials. Do not use a VITE_ prefix for these.
CLERK_SECRET_KEY=
MONGODB_URI=
